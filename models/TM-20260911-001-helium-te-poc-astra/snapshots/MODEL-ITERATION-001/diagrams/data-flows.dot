digraph data_flows {
    graph [label="TM-20260911-001 | Source-described data and control flows", labelloc=t, rankdir=LR];
    node [shape=box, fontname="sans-serif", fontsize=10];
    edge [fontname="sans-serif", fontsize=9];
    source [label="Source / configuration / packages"];
    build [label="Native build / preflight / image construction"];
    boot [label="Firmware + loaded image"];
    policy [label="HS fixed labels / seal / policy"];
    roots [label="HS-owned G-stage roots"];
    writer [label="Writer VS"];
    reader [label="Reader VS"];
    wprivate [label="Writer-private RW pages"];
    rprivate [label="Reader-private RW pages"];
    shared [label="Shared data\nWriter RW, reader R"];
    code [label="Common code\nBoth subjects RX"];
    trap [label="HS exact trap/state machine"];
    switch [label="HS reset / root / stack switch"];
    logs [label="SBI / emulator serial logs"];
    work [label="Captured-image retained work\nRO source/provenance; writable private copy"];
    bundle [label="Checked export / evidence bundle"];
    check [label="Offline correspondence checker"];
    docs [label="Generated site + client/browser"];
    human [label="Separate human review / blocked gate"];
    later [label="Reuse / disposal / interrupted state\nUnknown requirements", style=dashed];
    source -> build [label="FLOW-001"];
    build -> boot [label="FLOW-001 image"];
    boot -> policy [label="FLOW-002"];
    policy -> roots [label="FLOW-003"];
    roots -> writer [label="FLOW-004 initial entry"];
    writer -> wprivate [label="FLOW-005 RW", dir=both];
    writer -> shared [label="FLOW-005 shared RW", dir=both];
    code -> writer [label="FLOW-005 code RX"];
    writer -> trap [label="FLOW-006"];
    reader -> trap [label="FLOW-006"];
    trap -> switch [label="FLOW-007 validated completion"];
    roots -> switch [label="FLOW-007 reader root"];
    switch -> reader [label="FLOW-007 cleared state / new SP"];
    reader -> rprivate [label="FLOW-008 RW", dir=both];
    shared -> reader [label="FLOW-008 shared R"];
    code -> reader [label="FLOW-008 code RX"];
    trap -> logs [label="FLOW-009 guarded final result"];
    build -> work [label="FLOW-010 after native preflight"];
    work -> bundle [label="FLOW-010 namespace / provenance checks"];
    logs -> bundle [label="FLOW-009 retained records"];
    bundle -> check [label="FLOW-011"];
    source -> check [label="FLOW-011 exact-source comparison"];
    build -> docs [label="FLOW-012 generation / serving"];
    check -> human [label="FLOW-013 decision support"];
    docs -> human [label="FLOW-013 decision support"];
    bundle -> later [label="FLOW-014", style=dashed];
    trap -> later [label="FLOW-014 shutdown request", style=dashed];
    note [shape=note, label="No reader-to-shared write authority or cross-private mapping is shown.\nNo guest policy parser / SBI proxy / dynamic lifecycle is invented.\nFLOW-014 is Inferred; remaining arrows describe source, not a run.\nEvidence: TM-20260911-001-E0012, E0014, E0015, E0016,\nE0017, E0020, E0021, E0023, E0025, E0027, E0028, E0029."];
}
